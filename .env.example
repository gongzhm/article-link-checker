# 服务端口与监听地址
PORT=3003
HOST=127.0.0.1

# 数据目录：截图、Chrome 用户目录、图片指纹缓存都放这里
DATA_DIR=./data

# 允许调用接口的来源，逗号分隔（例如 https://tools.example.com）
# 留空 = 不校验来源，适合本机或内网自用
ALLOWED_ORIGINS=

# 可选：谷歌收录查询与搜索结果页截图依赖 DataForSEO
# 未填写时这两个功能会自动跳过，其余功能不受影响
# 取值是 username:password 的 base64
DATAFORSEO_AUTH=

# 可选：抓取网页时使用的 User-Agent
# USER_AGENT=ArticleLinkChecker/1.0

# 可选：Word 修订稿里显示的修订人
# REPORT_AUTHOR=Article Link Checker
